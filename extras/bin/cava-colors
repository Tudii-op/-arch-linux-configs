#!/usr/bin/env python3
"""Pick cava visualizer colors from the wallpaper pixels behind each visualizer.

Usage: cava-colors [bars|circle|wings|all]

  bars    7 colors left to right across the bars strip at the bottom of the
          screen (for glow_bars.frag). Also sets the bars surface size and
          position from the focused monitor, so this script is the one place
          that decides where the bars go.
  circle  7 colors around the ring, counter-clockwise from 3 o'clock (for
          prism_ring.frag). Uses the circle's own sdl_* position from its config.
  wings   7 colors left to right across the mirrored bars beside the circle
          (for mirror_wings.frag). Also centers the wings surface on the circle,
          so run it after the circle's geometry is final.

For each region it takes the most vivid tones (not the plain average, which
turns most wallpapers into mud), then lifts them so they stay visible:
brighter on dark wallpapers, darker on light ones. The colors are written as
gradient_color_N lines and the running cava-gl instance gets SIGUSR2, which
reloads colors live.

Runs from matugen's post_hook after every wallpaper change, and from
cava-wallpaper before it starts the bars. If anything fails, the config keeps
matugen's colors.
"""
import colorsys
import json
import math
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
WALLPAPER_CACHE = HOME / ".cache/ml4w/hyprland-dotfiles/current_wallpaper"
CONFS = {
    "bars": HOME / ".config/cava/bars.conf",
    "circle": HOME / ".config/cava/circle.conf",
    "wings": HOME / ".config/cava/wings.conf",
}
BARS_HEIGHT_PERCENT = 35  # share of the screen height the bars use (bottom of the screen)
WINGS_HEIGHT = 200        # px, the mirrored bars beside the circle (centered on its center)
STOPS = 7                 # cava only reads gradient_color_1..7
SCALE = 8                 # sample the wallpaper at 1/8 of the screen resolution
HUE_SPREAD = 1.5          # how much to exaggerate hue differences between regions
MAX_SPREAD = 60 / 360     # stop exaggerating once a hue is this far from the average
TAU = 2 * math.pi


def monitor_size():
    """Logical size of the focused monitor (layer-shell sizes are logical pixels)."""
    out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True,
                         check=True).stdout
    monitors = json.loads(out)
    m = next((m for m in monitors if m.get("focused")), monitors[0])
    w, h = m["width"], m["height"]
    if m.get("transform", 0) % 2 == 1:
        w, h = h, w
    scale = m.get("scale") or 1
    return round(w / scale), round(h / scale)


def screen_image(wallpaper, sw, sh):
    """The wallpaper as it looks on screen (cover + center crop, like awww),
    shrunk by SCALE. Returns (width, height, rows of (r, g, b) in 0..1)."""
    w, h = max(sw // SCALE, 1), max(sh // SCALE, 1)
    raw = subprocess.run(
        ["magick", f"{wallpaper}[0]", "-alpha", "off", "-colorspace", "sRGB",
         "-resize", f"{w}x{h}^", "-gravity", "center", "-extent", f"{w}x{h}",
         "-depth", "8", "rgb:-"],
        capture_output=True, check=True).stdout
    px = [(raw[i] / 255, raw[i + 1] / 255, raw[i + 2] / 255) for i in range(0, len(raw), 3)]
    return w, h, [px[y * w:(y + 1) * w] for y in range(h)]


def describe(pixels):
    """Hue, lightness and saturation of the most vivid tones in a region,
    plus its plain average lightness and how colorful it is overall."""
    sx = sy = wsum = lsum = ssum = avg_l = chroma_sum = 0.0
    for r, g, b in pixels:
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        chroma = max(r, g, b) - min(r, g, b)
        weight = chroma ** 3 + 1e-6  # vivid pixels decide the color
        sx += weight * math.cos(h * TAU)
        sy += weight * math.sin(h * TAU)
        wsum += weight
        lsum += weight * l
        ssum += weight * s
        avg_l += l
        chroma_sum += chroma
    n = max(len(pixels), 1)
    wsum = max(wsum, 1e-9)
    return {
        "hue": (math.atan2(sy, sx) / TAU) % 1.0,
        "l": lsum / wsum,
        "s": ssum / wsum,
        "avg_l": avg_l / n,
        "chroma": chroma_sum / n,
    }


def smoothstep(e0, e1, x):
    t = min(max((x - e0) / (e1 - e0), 0.0), 1.0)
    return t * t * (3 - 2 * t)


def lift(region, fallback_hue, mean_hue):
    """Turns a region description into a color that shows up on that region."""
    hue, l, s = region["hue"], region["l"], region["s"]
    if region["chroma"] < 0.04:  # gray area: soft tint of the wallpaper's main hue
        hue, s = fallback_hue, 0.3
    else:
        s = min(0.95, max(0.55, s * 1.15))
        # Push hues a bit away from the average so a mostly one-color
        # wallpaper still gives a gradient, not seven copies of one color.
        diff = (hue - mean_hue + 0.5) % 1.0 - 0.5
        # Hues already far from the average (orange lights on a teal
        # wallpaper) stay exactly as they are.
        spread = max(min(abs(diff) * HUE_SPREAD, MAX_SPREAD), abs(diff))
        hue = (mean_hue + math.copysign(spread, diff)) % 1.0
    # Bright on dark backgrounds, darker on light ones, with a smooth change between.
    bright = 0.60 + 0.18 * l
    dark = 0.32 + 0.15 * l
    l = bright + (dark - bright) * smoothstep(0.55, 0.8, region["avg_l"])
    r, g, b = colorsys.hls_to_rgb(hue, l, s)
    return "#{:02x}{:02x}{:02x}".format(*(round(c * 255) for c in (r, g, b)))


def mean_hue(regions):
    sx = sum(math.cos(r["hue"] * TAU) * r["chroma"] for r in regions)
    sy = sum(math.sin(r["hue"] * TAU) * r["chroma"] for r in regions)
    return (math.atan2(sy, sx) / TAU) % 1.0


def strip_regions(rows, img_w, img_h, x, y, w, h):
    """STOPS regions left to right across a screen rectangle (screen px)."""
    y0 = min(max(int(y / SCALE), 0), img_h - 1)
    y1 = min(max(int((y + h) / SCALE), y0 + 1), img_h)
    left, width = x / SCALE, w / SCALE
    regions = []
    for i in range(STOPS):
        center = i / (STOPS - 1)
        half = 0.5 / (STOPS - 1)
        x0 = min(max(int(left + (center - half) * width), 0), img_w - 1)
        x1 = min(max(int(left + (center + half) * width), x0 + 1), img_w)
        regions.append([p for row in rows[y0:y1] for p in row[x0:x1]])
    return regions


def conf_geometry(conf_text):
    """(width, height, x, y) from a config's sdl_* lines, or None."""
    def num(key):
        m = re.search(rf"^{key}\s*=\s*(-?\d+)", conf_text, re.M)
        return int(m.group(1)) if m else None

    geo = (num("sdl_width"), num("sdl_height"), num("sdl_x"), num("sdl_y"))
    if None in geo or geo[2] < 0 or geo[3] < 0:
        return None
    return geo


def circle_regions(img_w, img_h, rows, geo):
    size_w, size_h, x, y = geo
    cx, cy = (x + size_w / 2) / SCALE, (y + size_h / 2) / SCALE
    size = min(size_w, size_h) / SCALE
    r_in, r_out = 0.15 * size, 0.42 * size  # contour rings out to the spike tips
    regions = [[] for _ in range(STOPS)]
    for py in range(max(int(cy - r_out), 0), min(int(cy + r_out) + 1, img_h)):
        for px in range(max(int(cx - r_out), 0), min(int(cx + r_out) + 1, img_w)):
            dx, dy = px + 0.5 - cx, cy - (py + 0.5)  # y up, like the shader
            if not r_in <= math.hypot(dx, dy) <= r_out:
                continue
            a = (math.atan2(dy, dx) / TAU) % 1.0
            regions[round(a * STOPS) % STOPS].append(rows[py][px])
    return regions


def write_config(conf, colors, settings=None):
    text = conf.read_text()
    text = re.sub(r"^gradient_color_\d+\s*=.*\n", "", text, flags=re.M)
    lines = "".join(f"gradient_color_{i + 1} = '{c}'\n" for i, c in enumerate(colors))
    text, found = re.subn(r"^(gradient\s*=\s*1[ \t]*\n)", lambda m: m.group(1) + lines, text,
                          count=1, flags=re.M)
    if not found:
        raise SystemExit(f"cava-colors: no 'gradient = 1' line in {conf}")
    for key, value in (settings or {}).items():
        text = re.sub(rf"^{key}\s*=.*$", f"{key} = {value}", text, flags=re.M)
    tmp = conf.with_suffix(".tmp")
    tmp.write_text(text)
    tmp.replace(conf)
    subprocess.run(["pkill", "-USR2", "-f", f"cava-gl -p {conf}"], check=False)


def main():
    targets = sys.argv[1:] or ["all"]
    if targets == ["all"]:
        targets = list(CONFS)
    if any(t not in CONFS for t in targets):
        raise SystemExit(__doc__)

    wallpaper = Path(WALLPAPER_CACHE.read_text().strip())
    sw, sh = monitor_size()
    img_w, img_h, rows = screen_image(wallpaper, sw, sh)
    fallback_hue = describe([p for row in rows for p in row])["hue"]

    for target in targets:
        conf = CONFS[target]
        if not conf.exists():
            print(f"cava-colors: {conf} does not exist yet, skipping", file=sys.stderr)
            continue
        settings = None
        if target == "bars":
            bar_h = sh * BARS_HEIGHT_PERCENT // 100
            settings = {"sdl_width": sw, "sdl_height": bar_h, "sdl_x": 0, "sdl_y": sh - bar_h}
        else:
            circle = conf_geometry(CONFS["circle"].read_text())
            if circle is None:
                print(f"cava-colors: {target} needs the circle's sdl_width/height/x/y, skipping",
                      file=sys.stderr)
                continue
            if target == "wings":
                cw, ch, cx0, cy0 = circle
                cx, cy = cx0 + cw // 2, cy0 + ch // 2
                width = 2 * min(cx, sw - cx)
                settings = {"sdl_width": width, "sdl_height": WINGS_HEIGHT,
                            "sdl_x": cx - width // 2, "sdl_y": max(cy - WINGS_HEIGHT // 2, 0)}
        if settings:
            regions = strip_regions(rows, img_w, img_h, settings["sdl_x"], settings["sdl_y"],
                                    settings["sdl_width"], settings["sdl_height"])
        else:
            regions = circle_regions(img_w, img_h, rows, circle)
        described = [describe(r) for r in regions]
        center = mean_hue(described)
        colors = [lift(d, fallback_hue, center) for d in described]
        write_config(conf, colors, settings)
        print(f"{target}: {' '.join(colors)}")


if __name__ == "__main__":
    main()
