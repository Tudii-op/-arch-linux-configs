#!/usr/bin/env bash
# Music visualizer on the desktop background (below all windows, above the wallpaper).
# Usage: cava-wallpaper [toggle|start|stop|autostart]
#
# BACKEND=gl        glowing bars drawn by our cava-gl (glow_bars.frag), colors
#                   picked from the wallpaper behind them by cava-colors
# BACKEND=terminal  the old bars: stock cava inside a transparent kitty panel
BACKEND=gl

STATE="$HOME/.config/ml4w/settings/cava-wallpaper"   # on | off

GL_CONF="$HOME/.config/cava/bars.conf"
CAVA_GL="$HOME/.local/bin/cava-gl"
CAVA_COLORS="$HOME/.local/bin/cava-colors"           # also sets the gl bars' size/position
GL_PATTERN="cava-gl -p $GL_CONF"

TERM_CONF="$HOME/.config/cava/wallpaper.conf"
TERM_HEIGHT_PERCENT=35                               # gl backend: see BARS_HEIGHT_PERCENT in cava-colors
# kitty rewrites --class into --app-id in the process arguments
TERM_PATTERN="app-id=cava-wallpaper cava -p"

pattern() { if [ "$BACKEND" = gl ]; then echo "$GL_PATTERN"; else echo "$TERM_PATTERN"; fi; }
running() { pgrep -f "$(pattern)" >/dev/null; }

start_gl() {
    "$CAVA_COLORS" bars >/dev/null 2>&1   # if it fails, bars.conf keeps its last colors
    nohup "$CAVA_GL" -p "$GL_CONF" >/dev/null 2>&1 &
    disown
}

start_terminal() {
    local h top
    h=$(hyprctl monitors -j | jq '[.[] | select(.focused)][0].height')
    top=$(( h * (100 - TERM_HEIGHT_PERCENT) / 100 ))
    nohup kitten panel --edge=center --layer=bottom --focus-policy=not-allowed \
        --margin-top="$top" --class=cava-wallpaper \
        -o background_opacity=0 -o window_padding_width=0 -o font_size=4 \
        -o confirm_os_window_close=0 -o cursor_blink_interval=0 \
        cava -p "$TERM_CONF" >/dev/null 2>&1 &
}

start() {
    running && return
    echo on > "$STATE"
    if [ "$BACKEND" = gl ]; then start_gl; else start_terminal; fi
}

stop() {
    echo off > "$STATE"
    # stop both, so switching BACKEND never leaves the other one running
    pkill -f "$GL_PATTERN"
    pkill -f "$TERM_PATTERN"
}

case "${1:-toggle}" in
    start)     start ;;
    stop)      stop ;;
    autostart) [ "$(cat "$STATE" 2>/dev/null)" = "off" ] || start ;;
    toggle)    if running; then stop; else start; fi ;;
    *)         echo "Usage: cava-wallpaper [toggle|start|stop|autostart]"; exit 1 ;;
esac
